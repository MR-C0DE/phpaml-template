{
    "name": "phpaml/phpaml",
    "description": "Micro-framework MVC inspiré d'ASP.NET et Java EE",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "PHPAML\\": "aml_env/framework/",
            "App\\": "app/"
        }
    },
    "config": {
        "vendor-dir": "aml_env",
        "sort-packages": true
    },
    "scripts": {
        "test": "php tests/run.php",
        "analyse": "phpstan analyse"
    }
}
