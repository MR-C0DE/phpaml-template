{
    "name": "phpaml/phpaml",
    "description": "Official starter for structured PHPAML web applications",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "PHPAML\\": "runtime/framework/",
            "App\\": "app/"
        }
    },
    "config": {
        "vendor-dir": "runtime",
        "sort-packages": true
    },
    "scripts": {
        "test": "php tests/run.php",
        "test:http-security": "php tests/http-security.php",
        "analyse": "phpstan analyse"
    }
}
